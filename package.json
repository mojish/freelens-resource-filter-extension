{
  "name": "freelens-resource-filter-extension",
  "version": "0.5.0",
  "description": "Freelens extension: field-based filtering for any Kubernetes resource, including CRDs",
  "author": {
    "name": "Sotoon Delivery"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/mojish/freelens-resource-filter-extension.git"
  },
  "homepage": "https://github.com/mojish/freelens-resource-filter-extension#readme",
  "bugs": {
    "url": "https://github.com/mojish/freelens-resource-filter-extension/issues"
  },
  "main": "out/main/index.js",
  "renderer": "out/renderer/index.mjs",
  "files": [
    "out/**/*"
  ],
  "engines": {
    "node": ">= 22.0.0",
    "freelens": "^2.0.0"
  },
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "electron-vite build",
    "build:force": "electron-vite build --force",
    "build:production": "VITE_PRESERVE_MODULES=false electron-vite build",
    "type:check": "tsc --noEmit -p tsconfig.json --composite false && tsc --noEmit -p tsconfig.renderer.json --composite false",
    "prebuild": "pnpm type:check",
    "pretest": "pnpm build",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm type:check && pnpm build && pnpm test && pnpm pack",
    "pack:dev": "pnpm build:force && pnpm build && pnpm clean:tgz && pnpm pack",
    "clean": "pnpm clean:out",
    "clean:out": "pnpm dlx shx@0.4.0 rm -rf out",
    "clean:tgz": "pnpm dlx shx@0.4.0 rm -f \"*.tgz\""
  },
  "devDependencies": {
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@freelensapp/extensions": "^2.0.0",
    "@types/node": "~24.12.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.3",
    "electron": "44.10.0",
    "electron-vite": "^5.0.0",
    "mobx": "7.0.6",
    "mobx-react": "10.0.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "shx": "^0.4.0",
    "typescript": "5.9.3",
    "vite": "^8.1.2",
    "vitest": "^5.0.0",
    "yaml": "2.9.1"
  },
  "keywords": [
    "extension",
    "freelensapp",
    "freelens",
    "kubernetes",
    "k8s",
    "filter",
    "crd",
    "custom-resources"
  ]
}
