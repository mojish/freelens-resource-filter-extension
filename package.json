{
  "name": "freelens-resource-filter-extension",
  "version": "0.1.3",
  "description": "Freelens extension: generic field-based filtering for any Kubernetes resource list",
  "main": "out/main/index.js",
  "renderer": "out/renderer/index.js",
  "files": [
    "out/**/*"
  ],
  "engines": {
    "node": ">= 22.0.0",
    "freelens": "^1.10.0"
  },
  "license": "MIT",
  "scripts": {
    "build": "electron-vite build",
    "build:force": "electron-vite build --force",
    "build:production": "VITE_PRESERVE_MODULES=false electron-vite build",
    "type:check": "tsc --noEmit -p tsconfig.json --composite false",
    "prebuild": "pnpm type:check",
    "pack:dev": "pnpm build:force && pnpm build && pnpm clean:tgz && pnpm pack",
    "clean": "pnpm clean:out",
    "clean:out": "pnpm dlx shx@0.4.0 rm -rf out",
    "clean:tgz": "pnpm dlx shx@0.4.0 rm -f \"*.tgz\""
  },
  "devDependencies": {
    "@babel/plugin-proposal-decorators": "^8.0.2",
    "@electron-toolkit/tsconfig": "^2.0.0",
    "@freelensapp/extensions": "^1.10.2",
    "@types/node": "~24.12.4",
    "@types/react": "^17.0.93",
    "@vitejs/plugin-react": "^6.0.3",
    "electron-vite": "^5.0.0",
    "mobx": "6.13.7",
    "mobx-react": "7.6.0",
    "react": "17.0.2",
    "react-dom": "17.0.2",
    "shx": "^0.4.0",
    "typescript": "5.9.3",
    "vite": "^8.1.2"
  },
  "keywords": [
    "extension",
    "freelensapp",
    "freelens",
    "filter"
  ]
}
